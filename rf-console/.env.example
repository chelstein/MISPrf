APP_NAME=RF-Console
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# rf-console talks to MISP over HTTP. Schema is owned by MISP.
#
# Mock mode (default): UI works fully without a MISP server.
# Live mode: set RF_CONSOLE_USE_MOCK=false and configure the three
# MISP_* settings below.
RF_CONSOLE_USE_MOCK=true

# Live MISP target. Example deployment:
#   MISP_BASE_URL=https://167.99.183.214
# Note: when MISP_BASE_URL is an IP (or any host whose TLS cert does
# not match the URL hostname), set MISP_VERIFY_TLS=false. The default
# stays true so accidental misconfiguration fails closed.
MISP_BASE_URL=https://misp.local
MISP_API_KEY=
MISP_VERIFY_TLS=true
